# Copy to .env and fill in your keys. Never commit .env.

# --- Required ---------------------------------------------------------------
# LLM gateway (LiteLLM Router): at least one provider. They are tried in LLM_PROVIDERS
# order; a provider that is rate-limited or down is put in cooldown and the next answers.
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Pinecone (vector index + Pinecone Inference embeddings)
PINECONE_API_KEY=
# Cloudflare Workers AI (speech-to-text, image observations, text-to-speech)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Optional ---------------------------------------------------------------
# Research tools served by the project's MCP server (PubMed, openFDA, MedlinePlus
# need no key). Tavily enables the `web` tool; an NCBI key raises PubMed limits.
RESEARCH_TOOLS=true
TAVILY_API_KEY=
NCBI_API_KEY=
MCP_TIMEOUT_SECONDS=30
# stdio: spawn the server for each call (simplest locally).
# http: use a long-lived server at MCP_URL; start it with
#   python -m app.mcp_servers.medical_server --transport http
# (Docker and Render use http and start it automatically.)
MCP_TRANSPORT=stdio
MCP_URL=http://127.0.0.1:8001/mcp

ENVIRONMENT=development
LOG_LEVEL=INFO
# JSON log lines (recommended in production)
LOG_JSON=false

# answer lane (cited answer) and fast lane (triage, grading, planning, checks)
LLM_PROVIDERS=gemini,groq,cloudflare,openrouter
LLM_FAST_PROVIDERS=groq,cloudflare,gemini,openrouter
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
CLOUDFLARE_LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_TIMEOUT_SECONDS=45
# Seconds a failing provider is skipped before being tried again
LLM_COOLDOWN_SECONDS=60
# In-memory cache of identical prompts (exact match, never written to disk); 0 disables it
LLM_CACHE_TTL_SECONDS=3600

PINECONE_INDEX_NAME=medguide-kb
PINECONE_NAMESPACE=medical-kb
EMBED_MODEL=llama-text-embed-v2
EMBED_DIMENSIONS=768
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.30

# Voice used when the answer language is unknown (en, fr, es, zh, ja, ko)
TTS_DEFAULT_LANG=en

# Corrective loop budgets
MAX_TOOL_CALLS=3
MAX_RESEARCH_ROUNDS=2
MAX_QUERY_REWRITES=1

# Reflection: grounding check and usefulness check (one extra LLM call each)
GROUNDING_CHECK=true
MAX_GROUNDING_RETRIES=1
USEFULNESS_CHECK=true
MEMORY_TURNS=4

# SQLite file for conversations and LangGraph checkpoints
DATABASE_PATH=data/medguide.db

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Requests per window and per client IP on /api/chat and /api/speech (0 disables)
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
# Set to true only behind a trusted proxy (Render, nginx) to read X-Forwarded-For
TRUST_PROXY_HEADERS=false
# When set, every /api call except health needs "Authorization: Bearer <token>"
API_TOKEN=

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medguide-ai
